@model TallerCaldera2.Models.Vehicle
@{
    ViewData["Title"] = "Detalles del Vehículo";

    var maintenances = Model.Maintenances?
        .OrderByDescending(m => m.Date)
        .ToList() ?? new List<TallerCaldera2.Models.Maintenance>();

    var totalCost = maintenances.Sum(m => m.Cost ?? 0);
}

<style>
    .money-hidden {
        filter: blur(7px);
        user-select: none;
        transition: filter .2s ease;
    }

    .money-visible {
        filter: none;
    }

    .info-item {
        margin-bottom: .4rem;
        font-size: .95rem;
    }
</style>

<div class="container-fluid px-4 py-4">

    <!-- ================= HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-secondary fs-6 mb-2">@Model.Plate</span>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-car-front-fill me-2"></i>
                @Model.Brand @Model.Model
            </h2>
            <small class="text-muted">Detalle completo del vehículo</small>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>

            <a asp-controller="Maintenances"
               asp-action="Create"
               asp-route-vehiclePlate="@Model.Plate"
               class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuevo mantenimiento
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <!-- ================= INFO VEHÍCULO ================= -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body">
                    <h5 class="fw-semibold text-primary mb-3">
                        <i class="bi bi-info-circle me-2"></i> Información general
                    </h5>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="info-item"><strong>Cliente:</strong> @Model.ClientName</div>
                            <div class="info-item"><strong>Cédula:</strong> @Model.ClientIdNumber</div>
                            <div class="info-item"><strong>Teléfono:</strong> @Model.ClientPhone</div>
                            <div class="info-item"><strong>Correo:</strong> @Model.ClientEmail</div>
                            <div class="info-item"><strong>Dirección:</strong> @Model.ClientAddress</div>
                            <div class="info-item">
                                <strong>Marcha:</strong>
                                @if (Model.Marcha)
                                {
                                    <span class="badge bg-info">
                                        <i class="bi bi-gear-wide-connected"></i> Automático
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-gear"></i> Manual
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="info-item"><strong>Año:</strong> @Model.Year</div>
                            <div class="info-item"><strong>Combustible:</strong> @Model.FuelType</div>
                            <div class="info-item"><strong>Aceite:</strong> @Model.OilType</div>
                            <div class="info-item">
                                <strong>Último mantenimiento:</strong>
                                @(Model.LastMaintenanceDate?.ToString("dd/MM/yyyy") ?? "—")
                            </div>
                            <div class="info-item">
                                <strong>Registrado:</strong>
                                @Model.CreatedDate.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= ESTADÍSTICAS ================= -->
        <div class="col-lg-6">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-4 text-center h-100">
                        <div class="card-body">
                            <i class="bi bi-wrench-adjustable fs-2 text-primary"></i>
                            <h6 class="text-muted mt-2">Mantenimientos</h6>
                            <h3 class="fw-bold">@maintenances.Count</h3>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-4 text-center h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <i class="bi bi-cash-coin fs-2 text-success"></i>
                                <button class="btn btn-sm btn-outline-secondary"
                                        onclick="toggleMoney()"
                                        title="Mostrar / ocultar montos">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>

                            <h6 class="text-muted mt-2">Total invertido</h6>
                            <h3 class="fw-bold text-success money money-hidden">
                                ₡@totalCost.ToString("N0")
                            </h3>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ================= HISTORIAL ================= -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">
            <h5 class="fw-semibold text-primary mb-3">
                <i class="bi bi-clock-history me-2"></i> Historial de mantenimientos
            </h5>

            @if (!maintenances.Any())
            {
                <p class="text-muted mb-0">No hay mantenimientos registrados.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Kilometraje</th>
                                <th>Costo</th>
                                <th>Multimedia</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in maintenances)
                            {
                                <tr>
                                    <td>@m.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@m.Type</td>
                                    <td>@(m.Mileage?.ToString("N0") ?? "—") km</td>

                                    <td class="money money-hidden">
                                        ₡@(m.Cost?.ToString("N0") ?? "0")
                                    </td>

                                    <td>
                                        @if (m.Photos?.Any() == true)
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-image"></i> @m.Photos.Count
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }

                                        @if (m.SketchMarks?.Any() == true)
                                        {
                                            <span class="badge bg-warning ms-1">
                                                <i class="bi bi-pencil"></i>
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Maintenances"
                                           asp-action="Details"
                                           asp-route-id="@m.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Ver
                                        </a>

                                        <a asp-controller="Maintenances"
                                           asp-action="Edit"
                                           asp-route-id="@m.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <a asp-controller="Maintenances"
                                           asp-action="Delete"
                                           asp-route-id="@m.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

<script>
    function toggleMoney() {
        document.querySelectorAll('.money').forEach(el => {
            el.classList.toggle('money-hidden');
            el.classList.toggle('money-visible');
        });
    }
</script>