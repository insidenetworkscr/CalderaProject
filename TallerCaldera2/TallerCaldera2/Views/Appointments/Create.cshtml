@model TallerCaldera2.Models.Appointment

@{
    ViewData["Title"] = "Nueva Cita";
}

<h2 class="mb-4">Registrar nueva cita</h2>

<form asp-action="Create" method="post">

    <div class="form-group mb-3">
        <label asp-for="CustomerName" class="form-label">
            Nombre del cliente
        </label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="PhoneNumber" class="form-label">
            Teléfono
        </label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Vehicle" class="form-label">
            Vehículo
        </label>
        <input asp-for="Vehicle" class="form-control" />
        <span asp-validation-for="Vehicle" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Plate" class="form-label">
            Placa
        </label>
        <input asp-for="Plate" class="form-control" />
        <span asp-validation-for="Plate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="AppointmentDateTime" class="form-label">
            Fecha y hora de la cita
        </label>
        <input asp-for="AppointmentDateTime"
               type="datetime-local"
               class="form-control" />
        <span asp-validation-for="AppointmentDateTime" class="text-danger"></span>
    </div>

    <div class="form-group mb-4">
        <label asp-for="Status" class="form-label">
            Estado de la cita
        </label>
        <select asp-for="Status"
                class="form-control"
                asp-items="Html.GetEnumSelectList<AppointmentStatus>()">
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar cita
    </button>

    <a asp-action="Index" class="btn btn-secondary ms-2">
        Cancelar
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
