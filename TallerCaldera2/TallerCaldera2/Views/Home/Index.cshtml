@model TallerCaldera2.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    :root {
        --blue: #2563eb;
        --green: #16a34a;
        --orange: #f97316;
        --red: #dc2626;
        --gray: #6b7280;
        --bg: #f8fafc;
        --card-shadow: 0 8px 24px rgba(0,0,0,.05);
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg);
    }

    .dashboard {
        max-width: 1350px;
        margin: auto;
        padding: 30px 20px;
    }

    /* HEADER */
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
    }

        .header h2 {
            font-weight: 700;
            margin: 0;
        }

    .brands img {
        height: 52px;
        margin-left: 12px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 30px;
    }

    .main-logo {
        height: 200px;
        width: auto;
    }

    .header-text h2 {
        margin: 0;
        font-weight: 700;
    }

    .header-text small {
        color: var(--gray);
    }


    /* SUMMARY */
    .summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 45px;
    }

    .summary-card {
        background: white;
        border-radius: 14px;
        padding: 22px 26px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--card-shadow);
        border-left: 6px solid;
    }

        .summary-card h3 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .summary-card span {
            color: var(--gray);
            font-size: 14px;
        }

    .icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 20px;
    }

    .blue {
        border-color: var(--blue);
    }

    .green {
        border-color: var(--green);
    }

    .orange {
        border-color: var(--orange);
    }

    .red {
        border-color: var(--red);
    }

    .bg-blue {
        background: var(--blue);
    }

    .bg-green {
        background: var(--green);
    }

    .bg-orange {
        background: var(--orange);
    }

    .bg-red {
        background: var(--red);
    }

    /* QUICK ACCESS */
    .section-title {
        font-weight: 700;
        margin-bottom: 20px;
    }

    .quick {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
        margin-bottom: 45px;
    }

    .quick-card {
        background: white;
        border-radius: 14px;
        padding: 26px;
        box-shadow: var(--card-shadow);
        text-decoration: none;
        color: black;
        transition: .2s;
        border: 2px solid transparent;
    }

        .quick-card:hover {
            transform: translateY(-4px);
            border-color: var(--blue);
        }

        .quick-card i {
            font-size: 28px;
            margin-bottom: 10px;
            color: var(--blue);
        }

        .quick-card p {
            color: var(--gray);
            font-size: 14px;
            margin-bottom: 0;
        }

    /* CHARTS */
    .charts {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .chart-card {
        background: white;
        border-radius: 14px;
        padding: 22px;
        box-shadow: var(--card-shadow);
        text-align: center;
    }

        .chart-card h6 {
            font-weight: 600;
            margin-bottom: 15px;
        }

        .chart-card canvas {
            max-height: 180px !important;
        }

    footer {
        text-align: center;
        color: var(--gray);
        font-size: 14px;
        margin-top: 30px;
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <img src="~/images/logo-taller2.png" alt="Caldera Performance" class="main-logo">
            <div class="header-text">
                <h2>Caldera Performance</h2>
                <small class="text-muted">Especialistas en Honda & Toyota</small>
            </div>
        </div>

        <div class="brands">
            <img src="~/images/honda-logo.png" alt="Honda">
            <img src="~/images/toyota-logo.png" alt="Toyota">
        </div>
    </div>


    <!-- SUMMARY -->
    <div class="summary">
        <div class="summary-card red">
            <div>
                <h3>@Model.AlertasActivas</h3>
                <span>Alertas activas</span>
            </div>
            <div class="icon bg-red"><i class="fa-solid fa-triangle-exclamation"></i></div>
        </div>

        <div class="summary-card blue">
            <div>
                <h3>@Model.TotalVehiculos</h3>
                <span>Vehículos registrados</span>
            </div>
            <div class="icon bg-blue"><i class="fa-solid fa-car"></i></div>
        </div>

        <div class="summary-card green">
            <div>
                <h3>@Model.MantenimientosMes</h3>
                <span>Mantenimientos del mes</span>
            </div>
            <div class="icon bg-green"><i class="fa-solid fa-wrench"></i></div>
        </div>

        <div class="summary-card orange">
            <div>
                <h3>@Model.CitasPendientes</h3>
                <span>Citas pendientes</span>
            </div>
            <div class="icon bg-orange"><i class="fa-solid fa-calendar-days"></i></div>
        </div>
    </div>

    <!-- QUICK ACCESS -->
    <h5 class="section-title">Acceso rápido</h5>
    <div class="quick">
        <a asp-controller="Vehicles" asp-action="Index" class="quick-card">
            <i class="fa-solid fa-car"></i>
            <h6>Vehículos</h6>
            <p>Inventario y clientes</p>
        </a>

        <a asp-controller="Maintenances" asp-action="Index" class="quick-card">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <h6>Mantenimientos</h6>
            <p>Historial y servicios</p>
        </a>

        <a asp-controller="Alert" asp-action="Index" class="quick-card">
            <i class="fa-solid fa-bell"></i>
            <h6>Alertas</h6>
            <p>Notificaciones importantes</p>
        </a>

        <a asp-controller="Appointments" asp-action="Index" class="quick-card">
            <i class="fa-solid fa-calendar-check"></i>
            <h6>Citas</h6>
            <p>Agenda del taller</p>
        </a>
    </div>

    <!-- CHARTS -->
    <h5 class="section-title">Estadísticas</h5>
    <div class="charts">
        <div class="chart-card">
            <h6>Mantenimientos por mes</h6>
            <canvas id="mantenimientosChart"></canvas>
        </div>

        <div class="chart-card">
            <h6>Citas por estado</h6>
            <canvas id="citasChart"></canvas>
        </div>

        <div class="chart-card">
            <h6>Vehículos por marca</h6>
            <canvas id="vehiculosChart"></canvas>
        </div>
    </div>

    <footer>
        © @DateTime.Now.Year Caldera Performance
    </footer>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const commonOptions = {
        responsive: true,
        plugins: {
            legend: {
                position: 'bottom',
                labels: {
                    boxWidth: 12,
                    padding: 15
                }
            }
        }
    };

    new Chart(mantenimientosChart, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MesesMantenimientos)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CantidadMantenimientos)),
                backgroundColor: '#2563eb',
                borderRadius: 10,
                barThickness: 20
            }]
        },
        options: {
            ...commonOptions,
            plugins: { legend: { display: false } },
            scales: {
                y: { display: false },
                x: { grid: { display: false } }
            }
        }
    });

    new Chart(citasChart, {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EstadosCitas)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CantidadCitas)),
                backgroundColor: ['#16a34a', '#f97316', '#dc2626'],
                cutout: '72%'
            }]
        },
        options: commonOptions
    });

    new Chart(vehiculosChart, {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MarcasVehiculos)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CantidadVehiculos)),
                backgroundColor: ['#dc2626', '#2563eb'],
                cutout: '72%'
            }]
        },
        options: commonOptions
    });
</script>
