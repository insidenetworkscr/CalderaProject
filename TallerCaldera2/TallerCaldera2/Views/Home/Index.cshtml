@model TallerCaldera2.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
    :root {
        --blue: #2563eb;
        --green: #16a34a;
        --orange: #f97316;
        --red: #dc2626;
        --gray: #6b7280;
        --bg: #f8fafc;
        --card-shadow: 0 10px 28px rgba(0,0,0,.06);
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg);
    }

    .dashboard {
        max-width: 1350px;
        margin: auto;
        padding: 30px 20px;
    }

    /* ===== HEADER ===== */
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 26px;
    }

    .main-logo {
        height: 180px;
    }

    .header-text h2 {
        margin: 0;
        font-weight: 700;
        font-size: 1.6rem;
    }

    .header-text small {
        color: var(--gray);
    }

    /* ===== BRAND LOGOS (HONDA / TOYOTA) ===== */
    /* CONTENEDOR GENERAL */
    .brands {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    /* CONTENEDOR BASE DE CADA MARCA */
    .brand {
        width: 160px;
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* IMAGEN (NO SE TOCA EN HTML) */
    .brand-logo {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        display: block;
    }

    /* AJUSTES FINOS POR MARCA */
    .brand.honda {
        width: 160px;
    }

    .brand.toyota {
        width: 160px;
    }


    /* ===== SUMMARY ===== */
    .summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 50px;
    }

    .summary-card {
        background: white;
        border-radius: 16px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--card-shadow);
        border-left: 6px solid;
    }

        .summary-card h3 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .summary-card span {
            color: var(--gray);
            font-size: 14px;
        }

    .icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 20px;
    }

    .blue {
        border-color: var(--blue);
    }

    .green {
        border-color: var(--green);
    }

    .orange {
        border-color: var(--orange);
    }

    .red {
        border-color: var(--red);
    }

    .bg-blue {
        background: var(--blue);
    }

    .bg-green {
        background: var(--green);
    }

    .bg-orange {
        background: var(--orange);
    }

    .bg-red {
        background: var(--red);
    }

    /* ===== QUICK ===== */
    .section-title {
        font-weight: 700;
        margin-bottom: 20px;
    }

    .quick {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
        margin-bottom: 50px;
    }

    .quick-card {
        background: white;
        border-radius: 16px;
        padding: 26px;
        box-shadow: var(--card-shadow);
        text-decoration: none;
        color: black;
        transition: .25s;
        border: 2px solid transparent;
    }

        .quick-card:hover {
            transform: translateY(-5px);
            border-color: var(--blue);
        }

        .quick-card i {
            font-size: 28px;
            margin-bottom: 12px;
            color: var(--blue);
        }

        .quick-card p {
            color: var(--gray);
            font-size: 14px;
            margin-bottom: 0;
        }

    /* ===== CHARTS ===== */
    .charts {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 22px;
        margin-bottom: 40px;
    }

    .chart-card {
        background: white;
        border-radius: 16px;
        padding: 22px;
        box-shadow: var(--card-shadow);
        text-align: center;
        height: 300px;
    }

        .chart-card h6 {
            font-weight: 600;
            margin-bottom: 10px;
        }

        .chart-card canvas {
            max-height: 190px !important;
        }

    footer {
        text-align: center;
        color: var(--gray);
        font-size: 14px;
        margin-top: 30px;
    }

    @@media (max-width: 768px) {
        .header {
            flex-direction: column;
            gap: 20px;
        }

        .main-logo {
            height: 110px;
        }

        .brand {
            width: 95px;
            height: 55px;
        }

            .brand.honda {
                width: 85px;
            }

            .brand.toyota {
                width: 105px;
            }
    }
</style>

<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <div class="header-left">
            <img src="~/images/logo-taller2.png" class="main-logo">
            <div class="header-text">
                <h2>Caldera Performance</h2>
                <small>Especialistas en Honda & Toyota</small>
            </div>
        </div>

        <div class="brands">
            <div class="brand honda">
                <img src="~/images/honda-logo.png" class="brand-logo" alt="Honda">
            </div>

            <div class="brand toyota">
                <img src="~/images/toyota-logo.png" class="brand-logo" alt="Toyota">
            </div>
        </div>

    </div>

    <!-- SUMMARY -->
    <div class="summary">
        <div class="summary-card red">
            <div>
                <h3>@Model.AlertasActivas</h3>
                <span>Alertas activas</span>
            </div>
            <div class="icon bg-red"><i class="fa-solid fa-triangle-exclamation"></i></div>
        </div>

        <div class="summary-card blue">
            <div>
                <h3>@Model.TotalVehiculos</h3>
                <span>Vehículos registrados</span>
            </div>
            <div class="icon bg-blue"><i class="fa-solid fa-car"></i></div>
        </div>

        <div class="summary-card green">
            <div>
                <h3>@Model.MantenimientosMes</h3>
                <span>Mantenimientos del mes</span>
            </div>
            <div class="icon bg-green"><i class="fa-solid fa-wrench"></i></div>
        </div>

        <div class="summary-card orange">
            <div>
                <h3>@Model.CitasPendientes</h3>
                <span>Citas pendientes</span>
            </div>
            <div class="icon bg-orange"><i class="fa-solid fa-calendar-days"></i></div>
        </div>
    </div>

    <!-- QUICK -->
    <h5 class="section-title">Acceso rápido</h5>
    <div class="quick">
        <a asp-controller="Vehicles" asp-action="Index" class="quick-card">
            <i class="fa-solid fa-car"></i>
            <h6>Vehículos</h6>
            <p>Inventario y clientes</p>
        </a>

        <a asp-controller="Maintenances" asp-action="Index" class="quick-card">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <h6>Mantenimientos</h6>
            <p>Historial y servicios</p>
        </a>

        <a asp-controller="Alert" asp-action="Index" class="quick-card">
            <i class="fa-solid fa-bell"></i>
            <h6>Alertas</h6>
            <p>Notificaciones importantes</p>
        </a>

        <a asp-controller="Appointments" asp-action="Index" class="quick-card">
            <i class="fa-solid fa-calendar-check"></i>
            <h6>Citas</h6>
            <p>Agenda del taller</p>
        </a>
    </div>

    <!-- CHARTS -->
    <h5 class="section-title">Estadísticas</h5>
    <div class="charts">
        <div class="chart-card">
            <h6>Mantenimientos por mes</h6>
            <canvas id="mantenimientosChart"></canvas>
        </div>

        <div class="chart-card">
            <h6>Citas por estado</h6>
            <canvas id="citasChart"></canvas>
        </div>

        <div class="chart-card">
            <h6>Vehículos por marca</h6>
            <canvas id="vehiculosChart"></canvas>
        </div>
    </div>

    <footer>
        © @DateTime.Now.Year Caldera Performance
    </footer>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const marcasVehiculos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MarcasVehiculos));
    const estadosCitas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EstadosCitas));

    function generateColors(count) {
        const palette = [
            '#2563eb', '#dc2626', '#16a34a', '#f97316',
            '#7c3aed', '#0891b2', '#db2777', '#65a30d',
            '#9333ea', '#0d9488', '#ca8a04', '#be123c'
        ];
        return palette.slice(0, count);
    }

    const commonOptions = {
        responsive: true,
        plugins: {
            legend: {
                position: 'bottom',
                labels: { boxWidth: 12, padding: 15 }
            }
        }
    };

    new Chart(mantenimientosChart, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MesesMantenimientos)),
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CantidadMantenimientos)),
                backgroundColor: '#2563eb',
                borderRadius: 10,
                barThickness: 20
            }]
        },
        options: {
            ...commonOptions,
            plugins: { legend: { display: false } },
            scales: {
                y: { display: false },
                x: { grid: { display: false } }
            }
        }
    });

    new Chart(citasChart, {
        type: 'doughnut',
        data: {
            labels: estadosCitas,
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CantidadCitas)),
                backgroundColor: generateColors(estadosCitas.length),
                cutout: '72%'
            }]
        },
        options: commonOptions
    });

    new Chart(vehiculosChart, {
        type: 'doughnut',
        data: {
            labels: marcasVehiculos,
            datasets: [{
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CantidadVehiculos)),
                backgroundColor: generateColors(marcasVehiculos.length),
                cutout: '72%'
            }]
        },
        options: commonOptions
    });
</script>
