@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var current = Context.Request.Path.Value?.ToLower() ?? "";
    string Active(string path) => current.Contains(path.ToLower()) ? "active fw-bold" : "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Caldera Performance</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #dc2626;
            --primary-dark: #991b1b;
            --primary-light: #fef2f2;
            --header-height: 72px;
            --shadow: 0 6px 20px rgba(0,0,0,.12);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== HEADER ===== */
        .main-header {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));
            height: var(--header-height);
            position: sticky;
            top: 0;
            z-index: 1030;
            box-shadow: var(--shadow);
        }

        .header-container {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: white;
            text-decoration: none;
        }

        .logo-img {
            height: 52px;
        }

        .logo-text {
            font-family: 'Poppins';
            font-size: 1.35rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .logo-subtitle {
            font-size: .75rem;
            opacity: .9;
        }

        /* ===== NAV DESKTOP ===== */
        .main-nav {
            display: flex;
            gap: .4rem;
            align-items: center;
        }

        .nav-link-custom {
            padding: .7rem 1.1rem;
            color: rgba(255,255,255,.9);
            text-decoration: none;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: .45rem;
            transition: .2s;
            font-weight: 500;
        }

            .nav-link-custom:hover,
            .nav-link-custom.active {
                background: rgba(255,255,255,.22);
                color: #fff;
            }

        /* ===== MAIN ===== */
        .main-content {
            flex: 1;
            padding: 2rem;
            min-height: calc(100vh - var(--header-height));
        }

        /* ===== OFFCANVAS ===== */
        .offcanvas {
            background: #f8fafc;
        }

            .offcanvas .nav-link-custom {
                color: #334155;
                margin-bottom: .4rem;
                border-radius: 6px;
            }

                .offcanvas .nav-link-custom.active {
                    background: var(--primary-light);
                    color: var(--primary-color);
                }
    </style>
</head>

<body>

    @if (HttpContextAccessor.HttpContext.Session.GetString("UserName") != null)
    {
        <!-- ===== HEADER ===== -->
        <header class="main-header">
            <div class="header-container">

                <!-- LOGO -->
                <a asp-controller="Home" asp-action="Index" class="logo-section">
                    <img src="~/images/logo-taller2.png" class="logo-img" alt="Caldera Performance" />
                    <div class="logo-text">
                        Caldera Performance
                        <div class="logo-subtitle">Sistema de Gestión del Taller</div>
                    </div>
                </a>

                <!-- NAV DESKTOP -->
                <nav class="main-nav d-none d-lg-flex">

                    <a class="nav-link-custom @Active("/home")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>

                    <a class="nav-link-custom @Active("/vehicles")" asp-controller="Vehicles" asp-action="Index">
                        <i class="bi bi-car-front"></i> Vehículos
                    </a>

                    <a class="nav-link-custom @Active("/maintenances")" asp-controller="Maintenances" asp-action="Index">
                        <i class="bi bi-tools"></i> Mantenimientos
                    </a>

                    <a class="nav-link-custom @Active("/alert")" asp-controller="Alert" asp-action="Index">
                        <i class="bi bi-exclamation-octagon"></i> Alertas
                    </a>

                    <a class="nav-link-custom @Active("/appointments")" asp-controller="Appointments" asp-action="Index">
                        <i class="bi bi-calendar-event"></i> Citas
                    </a>

                    <a class="nav-link-custom @Active("/proformas")" asp-controller="Proformas" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i> Proformas
                    </a>

                    <span class="text-white ms-3">
                        <i class="bi bi-person-circle"></i>
                        @HttpContextAccessor.HttpContext.Session.GetString("UserName")
                    </span>

                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-sm btn-outline-light ms-3">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </nav>

                <!-- BOTÓN MÓVIL -->
                <button class="btn btn-outline-light d-lg-none"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileMenu">
                    <i class="bi bi-list fs-2"></i>
                </button>

            </div>
        </header>

        <!-- ===== OFFCANVAS MOBILE ===== -->
        <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title">Menú</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
            </div>

            <div class="offcanvas-body">

                <a class="nav-link-custom @Active("/home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <a class="nav-link-custom @Active("/vehicles")" asp-controller="Vehicles" asp-action="Index">
                    <i class="bi bi-car-front"></i> Vehículos
                </a>

                <a class="nav-link-custom @Active("/maintenances")" asp-controller="Maintenances" asp-action="Index">
                    <i class="bi bi-tools"></i> Mantenimientos
                </a>

                <a class="nav-link-custom @Active("/alert")" asp-controller="Alert" asp-action="Index">
                    <i class="bi bi-exclamation-octagon"></i> Alertas
                </a>

                <a class="nav-link-custom @Active("/appointments")" asp-controller="Appointments" asp-action="Index">
                    <i class="bi bi-calendar-event"></i> Citas
                </a>

                <a class="nav-link-custom @Active("/proformas")" asp-controller="Proformas" asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i> Proformas
                </a>

                <hr>

                <div class="mb-3">
                    <i class="bi bi-person-circle"></i>
                    @HttpContextAccessor.HttpContext.Session.GetString("UserName")
                </div>

                <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger w-100">
                    <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                </a>
            </div>
        </div>
    }

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- FIX OFFCANVAS MOBILE REDIRECT -->
    <script>
        document.querySelectorAll('#mobileMenu a').forEach(link => {
            link.addEventListener('click', () => {
                const offcanvasEl = document.getElementById('mobileMenu');
                const instance = bootstrap.Offcanvas.getInstance(offcanvasEl);
                if (instance) instance.hide();
            });
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
