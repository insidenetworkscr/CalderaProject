@{
    var current = Context.Request.Path.Value?.ToLower() ?? "";
    string Active(string path) => current.Contains(path.ToLower()) ? "active fw-bold" : "";
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Caldera Performance</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #dc2626;
            --primary-dark: #991b1b;
            --primary-light: #fef2f2;
            --box-shadow: 0 4px 20px rgba(0,0,0,.08);
            --header-height: 70px;
            --transition-speed: .3s;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ===== HEADER ===== */
        .main-header {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));
            height: var(--header-height);
            position: sticky;
            top: 0;
            z-index: 1030;
            box-shadow: 0 4px 12px rgba(0,0,0,.1);
        }

        .header-container {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 1rem;
            color: white;
            text-decoration: none;
        }

        .logo-icon {
            background: rgba(255,255,255,.15);
            width: 45px;
            height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .logo-text {
            font-family: 'Poppins';
            font-size: 1.4rem;
            font-weight: 700;
            line-height: 1.1;
        }

        .logo-subtitle {
            font-size: .75rem;
            opacity: .9;
        }

        .main-nav {
            display: flex;
            gap: .5rem;
        }

        .nav-link-custom {
            padding: .75rem 1.25rem;
            color: rgba(255,255,255,.9);
            text-decoration: none;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: .5rem;
            transition: .2s;
        }

            .nav-link-custom:hover,
            .nav-link-custom.active {
                background: rgba(255,255,255,.2);
                color: white;
            }

        .nav-badge {
            background: #f59e0b;
            font-size: .7rem;
            padding: .15rem .5rem;
            border-radius: 10px;
            font-weight: 600;
        }

        /* ===== MAIN ===== */
        .main-content {
            flex: 1;
            padding: 2rem;
            min-height: calc(100vh - var(--header-height) - 80px);
        }

        /* ===== FOOTER (CORREGIDO Y ROJO) ===== */
        .main-footer {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));
            padding: 1.5rem 2rem;
            color: rgba(255,255,255,.9);
            box-shadow: 0 -4px 12px rgba(0,0,0,.08);
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-links {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

            .footer-links a {
                color: rgba(255,255,255,.85);
                text-decoration: none;
                font-size: .9rem;
            }

                .footer-links a:hover {
                    color: white;
                    text-decoration: underline;
                }

        .copyright {
            font-size: .85rem;
            opacity: .9;
        }

        @@media (max-width: 768px) {
            .footer-content {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <header class="main-header">
        <div class="header-container">
            <a asp-controller="Home" asp-action="Index" class="logo-section">
                <div class="logo-icon"><i class="bi bi-gear-fill"></i></div>
                <div class="logo-text">
                    Caldera Performance
                    <div class="logo-subtitle">Sistema de Gestión del Taller</div>
                </div>
            </a>

            <nav class="main-nav d-none d-lg-flex">
                <a class="nav-link-custom @Active("/home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="nav-link-custom @Active("/vehicles")" asp-controller="Vehicles" asp-action="Index"><i class="bi bi-car-front"></i> Vehículos</a>
                <a class="nav-link-custom @Active("/maintenances")" asp-controller="Maintenances" asp-action="Index"><i class="bi bi-tools"></i> Mantenimientos</a>
                <a class="nav-link-custom @Active("/alert")" asp-controller="Alert" asp-action="Index"><i class="bi bi-exclamation-octagon"></i> Alertas</a>
                <a class="nav-link-custom @Active("/appointments")" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-event"></i> Citas</a>
            </nav>
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>

@functions {
    private string GetPageIcon()
    {
        var current = Context.Request.Path.Value?.ToLower() ?? "";
        if (current.Contains("/vehicles")) return "bi-car-front";
        if (current.Contains("/maintenances")) return "bi-tools";
        if (current.Contains("/alert")) return "bi-exclamation-octagon";
        if (current.Contains("/appointments")) return "bi-calendar-event";
        if (current.Contains("/home")) return "bi-speedometer2";
        return "bi-house";
    }
}
