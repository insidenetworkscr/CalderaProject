@model TallerCaldera2.Models.Proforma

<h2>Nueva Proforma</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Debug"] != null)
{
    <div class="alert alert-warning">@TempData["Debug"]</div>
}

<form asp-action="Create" method="post">
    <input asp-for="ClienteNombre" class="form-control mb-2" placeholder="Cliente" />
    <input asp-for="ClienteTelefono" class="form-control mb-2" placeholder="Teléfono" />
    <input asp-for="ClienteEmail" class="form-control mb-2" placeholder="Email" />

    <table class="table" id="itemsTable">
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td><input asp-for="Items[@i].Descripcion" class="form-control" /></td>
                    <td><input asp-for="Items[@i].Cantidad" type="number" class="form-control" /></td>
                    <td><input asp-for="Items[@i].PrecioUnitario" type="number" step="0.01" class="form-control" /></td>
                    <td><button type="button" onclick="removeRow(this)">X</button></td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" onclick="addRow()">➕ Item</button>
    <br /><br />
    <button class="btn btn-success">Guardar</button>
</form>

@section Scripts {
    <script>
        function addRow() {
            let i = document.querySelectorAll("#itemsTable tr").length;
            document.querySelector("#itemsTable tbody").insertAdjacentHTML("beforeend",
            `<tr>
                <td><input name="Items[${i}].Descripcion" class="form-control"/></td>
                <td><input name="Items[${i}].Cantidad" type="number" class="form-control"/></td>
                <td><input name="Items[${i}].PrecioUnitario" type="number" step="0.01" class="form-control"/></td>
                <td><button type="button" onclick="removeRow(this)">X</button></td>
            </tr>`);
        }
        function removeRow(btn) {
            btn.closest("tr").remove();
        }
    </script>
}
