@model TallerCaldera2.Models.Maintenance

@{
    ViewData["Title"] = "Editar mantenimiento";
    var initialSketch = string.Join("|", Model.SketchMarks?.Select(m => m.PosX + "," + m.PosY) ?? Enumerable.Empty<string>());
}

<h2 class="mb-4">✏️ Editar mantenimiento</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Edit" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- ================= DATOS GENERALES ================= -->
            <h6 class="text-muted mb-3">Información general</h6>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="VehiclePlate" class="form-label">Placa</label>
                    <select asp-for="VehiclePlate" class="form-control" asp-items="ViewBag.VehiclePlate"></select>
                    <span asp-validation-for="VehiclePlate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Type" class="form-label"></label>
                    <input asp-for="Type" class="form-control" />
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Provider" class="form-label">Proveedor</label>
                    <input asp-for="Provider" class="form-control" />
                    <span asp-validation-for="Provider" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Observations" class="form-label"></label>
                <textarea asp-for="Observations" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observations" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Cost" class="form-label"></label>
                    <input asp-for="Cost" class="form-control" />
                    <span asp-validation-for="Cost" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Mileage" class="form-label"></label>
                    <input asp-for="Mileage" class="form-control" />
                    <span asp-validation-for="Mileage" class="text-danger"></span>
                </div>
            </div>

            <hr />

            <!-- ================= FOTOS ================= -->
            <h6 class="text-muted mb-3">Fotos del mantenimiento</h6>

            @if (Model.Photos != null && Model.Photos.Any())
            {
                <div class="d-flex flex-wrap gap-3 mb-3">
                    @foreach (var photo in Model.Photos)
                    {
                        <div class="text-center">
                            <img src="@photo.ImageUrl" class="photo-thumb mb-1" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="deletePhotoIds"
                                       value="@photo.Id"
                                       id="photo_@photo.Id" />
                                <label class="form-check-label small" for="photo_@photo.Id">
                                    Eliminar
                                </label>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No hay fotos registradas.</p>
            }

            <div class="mb-3">
                <label class="form-label">Agregar nuevas fotos</label>
                <input type="file" name="newPhotos" class="form-control" multiple />
            </div>

            <hr />

            <!-- ================= BOCETO ================= -->
            <div class="card mt-4">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Boceto del vehículo</h6>
                    <small class="text-muted d-block mb-3">
                        Click para agregar una <strong>X</strong>, click sobre la <strong>X</strong> para quitarla
                    </small>

                    <div id="sketch-container"
                         class="border rounded sketch-container mx-auto"
                         style="max-width:500px;"
                         data-initial-marks="@initialSketch">
                        <img id="sketch-image"
                             src="~/images/car-sketch.png"
                             class="img-fluid" />
                    </div>
                </div>
            </div>

            <input type="hidden" id="SketchData" name="SketchData" />

            <!-- ================= BOTONES ================= -->
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    💾 Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    ↩ Volver
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        .photo-thumb {
            width: 90px;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .sketch-container {
            position: relative;
            display: inline-block;
            background: #f8f9fa;
        }

        .sketch-mark {
            position: absolute;
            color: #dc3545;
            font-weight: bold;
            font-size: 20px;
            transform: translate(-50%, -50%);
            cursor: pointer;
            user-select: none;
            text-shadow: 0 0 4px rgba(0,0,0,0.2);
        }
    </style>

    <script>
        (function () {
            const container = document.getElementById('sketch-container');
            const hidden = document.getElementById('SketchData');
            let marks = [];

            function renderMarks() {
                container.querySelectorAll('.sketch-mark').forEach(m => m.remove());

                marks.forEach((m, index) => {
                    const el = document.createElement('div');
                    el.className = 'sketch-mark';
                    el.textContent = 'X';
                    el.style.left = m.x + 'px';
                    el.style.top = m.y + 'px';
                    el.dataset.index = index;

                    el.addEventListener('click', function (ev) {
                        ev.stopPropagation();
                        marks.splice(parseInt(this.dataset.index), 1);
                        renderMarks();
                    });

                    container.appendChild(el);
                });

                hidden.value = marks.map(m => m.x + ',' + m.y).join('|');
            }

            const initial = container.getAttribute('data-initial-marks');
            if (initial) {
                initial.split('|').forEach(p => {
                    const xy = p.split(',');
                    if (xy.length === 2) {
                        const x = parseInt(xy[0]);
                        const y = parseInt(xy[1]);
                        if (!isNaN(x) && !isNaN(y)) {
                            marks.push({ x, y });
                        }
                    }
                });
                renderMarks();
            }

            container.addEventListener('click', function (e) {
                const rect = container.getBoundingClientRect();
                marks.push({
                    x: Math.round(e.clientX - rect.left),
                    y: Math.round(e.clientY - rect.top)
                });
                renderMarks();
            });
        })();
    </script>
}

