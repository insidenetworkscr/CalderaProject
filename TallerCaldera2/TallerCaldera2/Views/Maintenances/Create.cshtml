@model TallerCaldera2.Models.Maintenance

@{
    ViewData["Title"] = "Nuevo mantenimiento";

    if (Model.Items == null)
    {
        Model.Items = new List<TallerCaldera2.Models.MaintenanceItem>();
    }
}

<div class="container py-4">

    <!-- ================= HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-wrench-adjustable me-2"></i> Registrar mantenimiento
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <form asp-action="Create" enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- ================= DATOS GENERALES ================= -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-info-circle me-2"></i> Datos del mantenimiento
            </div>

            <div class="card-body row g-3">
                <div class="col-md-3">
                    <label asp-for="Date" class="form-label">Fecha</label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="VehiclePlate" class="form-label">Vehículo</label>
                    <select asp-for="VehiclePlate"
                            class="form-select"
                            asp-items="ViewBag.VehiclePlate">
                    </select>
                    <span asp-validation-for="VehiclePlate" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Type" class="form-label">Tipo de mantenimiento</label>
                    <input asp-for="Type" class="form-control" placeholder="Preventivo, correctivo…" />
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Provider" class="form-label">Proveedor</label>
                    <input asp-for="Provider" class="form-control" placeholder="Repuestos XYZ" />
                    <span asp-validation-for="Provider" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Mileage" class="form-label">Kilometraje</label>
                    <input asp-for="Mileage" class="form-control" placeholder="120 000" />
                    <span asp-validation-for="Mileage" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FormaPago" class="control-label"></label>
                    <input asp-for="FormaPago" class="form-control"
                           placeholder="Ej: 50% efectivo, 50% tarjeta" />
                </div>

                <div class="form-group">
                    <label class="control-label">Nivel de Combustible</label>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Combustible" value="Bajo">
                        <label class="form-check-label">Bajo</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Combustible" value="Medio">
                        <label class="form-check-label">Medio</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Combustible" value="Alto">
                        <label class="form-check-label">Alto</label>
                    </div>
                </div>


                <!-- COSTO AUTOMATICO -->
                <div class="col-md-4 mb-3">
                    <label>Costo total</label>
                    <input asp-for="Cost" class="form-control" readonly />
                </div>

                <div class="col-md-12">
                    <label asp-for="Observations" class="form-label">Observaciones</label>
                    <textarea asp-for="Observations"
                              class="form-control"
                              rows="3"
                              placeholder="Detalle del trabajo realizado…">
                    </textarea>
                    <span asp-validation-for="Observations" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="TrabajosPorRealizar"></label>
                    <textarea asp-for="TrabajosPorRealizar" class="form-control"></textarea>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="TrabajosRealizados"></label>
                    <textarea asp-for="TrabajosRealizados" class="form-control"></textarea>
                </div>

            </div>

            <hr />

            <!-- ================= SERVICIOS ================= -->

            <h5>Servicios</h5>

            <table class="table table-bordered" id="itemsTable">
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th>Unidad</th>
                        <th>Precio</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                </tbody>
            </table>

            <button type="button" class="btn btn-success mb-3" id="addRow">
                ➕ Agregar servicio
            </button>

            <hr />

            <!-- ================= FOTOS ================= -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-camera me-2"></i> Evidencia fotográfica
                </div>

                <div class="card-body">
                    <label class="form-label">Fotos del mantenimiento</label>
                    <input type="file" name="photos" class="form-control" multiple />
                    <small class="text-muted">
                        Puede seleccionar varias imágenes del trabajo realizado.
                    </small>
                </div>
            </div>

            <!-- ================= BOCETO ================= -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-pencil-square me-2"></i> Boceto del vehículo
                </div>

                <div class="card-body">
                    <p class="text-muted mb-2">
                        Haga clic sobre el vehículo para marcar daños o revisiones (<strong>X</strong>).
                        Haga clic sobre una marca para eliminarla.
                    </p>

                    <div id="sketch-container"
                         class="sketch-container border rounded p-2"
                         style="max-width:600px;">
                        <img id="sketch-image"
                             src="~/images/car-sketch.png"
                             class="img-fluid"
                             alt="Boceto del vehículo" />
                    </div>

                    <input type="hidden" id="SketchData" name="SketchData" />
                </div>
            </div>

            <!-- ================= ACCIONES ================= -->
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> Guardar mantenimiento
                </button>
            </div>

    </form>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />
    <style>
        .sketch-container {
            position: relative;
            display: inline-block;
        }

        .sketch-mark {
            position: absolute;
            color: red;
            font-weight: bold;
            font-size: 22px;
            transform: translate(-50%, -50%);
            cursor: pointer;
            user-select: none;
        }
    </style>
    <script>

        // ===== COSTO AUTOMATICO =====

        function calcularCostoTotal() {

            let total = 0;

            document.querySelectorAll("#itemsTable tbody tr").forEach(row => {

                let unidad = parseFloat(row.querySelector('[name*=".Unidad"]')?.value) || 0;
                let precio = parseFloat(row.querySelector('[name*=".Precio"]')?.value) || 0;

                total += unidad * precio;
            });

            document.querySelector('[name="Cost"]').value = total.toFixed(2);
        }

        document.addEventListener("input", function (e) {

            if (e.target.name?.includes("Unidad") ||
                e.target.name?.includes("Precio")) {

                calcularCostoTotal();
            }
        });


        // ===== AGREGAR FILA =====

        document.getElementById("addRow").addEventListener("click", function () {

            let table = document.querySelector("#itemsTable tbody");
            let index = table.rows.length;

            let row = `
            <tr>
                <td>
                    <input name="Items[${index}].Servicio" class="form-control" />
                </td>
                <td>
                    <input name="Items[${index}].Unidad" type="number" class="form-control" />
                </td>
                <td>
                    <input name="Items[${index}].Precio" type="number" class="form-control" />
                </td>
                <td>
                    <button type="button" class="btn btn-danger remove-row">X</button>
                </td>
            </tr>`;

            table.insertAdjacentHTML("beforeend", row);

            calcularCostoTotal();
        });


        // ===== ELIMINAR FILA =====

        document.addEventListener("click", function (e) {

            if (e.target.classList.contains("remove-row")) {
                e.target.closest("tr").remove();
                calcularCostoTotal();
            }
        });
    </script>




    <script>
              // ===== BOCETO =====
        (function () {
            const container = document.getElementById('sketch-container');
            const hidden = document.getElementById('SketchData');
            let marks = [];

            function renderMarks() {
                container.querySelectorAll('.sketch-mark').forEach(m => m.remove());

                marks.forEach((m, index) => {
                    const el = document.createElement('div');
                    el.className = 'sketch-mark';
                    el.textContent = 'X';
                    el.style.left = m.x + 'px';
                    el.style.top = m.y + 'px';
                    el.dataset.index = index;

                    el.addEventListener('click', function (ev) {
                        ev.stopPropagation();
                        marks.splice(parseInt(this.dataset.index), 1);
                        renderMarks();
                    });

                    container.appendChild(el);
                });

                hidden.value = marks.map(m => m.x + ',' + m.y).join('|');
            }

            container.addEventListener('click', function (e) {
                const rect = container.getBoundingClientRect();
                marks.push({
                    x: Math.round(e.clientX - rect.left),
                    y: Math.round(e.clientY - rect.top)
                });
                renderMarks();
            });
        })();
    </script>



}