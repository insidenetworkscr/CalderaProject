@model TallerCaldera2.Models.Maintenance

@{
    ViewData["Title"] = "Nuevo mantenimiento";
}

<div class="container py-4">

    <!-- ================= HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-wrench-adjustable me-2"></i> Registrar mantenimiento
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <form asp-action="Create" enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- ================= DATOS GENERALES ================= -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-info-circle me-2"></i> Datos del mantenimiento
            </div>

            <div class="card-body row g-3">
                <div class="col-md-3">
                    <label asp-for="Date" class="form-label">Fecha</label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="VehiclePlate" class="form-label">Vehículo</label>
                    <select asp-for="VehiclePlate"
                            class="form-select"
                            asp-items="ViewBag.VehiclePlate">
                    </select>
                    <span asp-validation-for="VehiclePlate" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Type" class="form-label">Tipo de mantenimiento</label>
                    <input asp-for="Type" class="form-control" placeholder="Preventivo, correctivo…" />
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Provider" class="form-label">Proveedor</label>
                    <input asp-for="Provider" class="form-control" placeholder="Repuestos XYZ" />
                    <span asp-validation-for="Provider" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Mileage" class="form-label">Kilometraje</label>
                    <input asp-for="Mileage" class="form-control" placeholder="120 000" />
                    <span asp-validation-for="Mileage" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Cost" class="form-label">Costo</label>
                    <input asp-for="Cost" class="form-control" placeholder="₡" />
                    <span asp-validation-for="Cost" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Observations" class="form-label">Observaciones</label>
                    <textarea asp-for="Observations"
                              class="form-control"
                              rows="3"
                              placeholder="Detalle del mantenimiento…"></textarea>
                </div>

                <!-- 🔹 NUEVOS CAMPOS -->
                <div class="col-md-12">
                    <label asp-for="TrabajosPorRealizar" class="form-label">
                        Trabajos por realizar
                    </label>
                    <textarea asp-for="TrabajosPorRealizar"
                              class="form-control"
                              rows="3"
                              placeholder="Trabajos pendientes o por realizar…"></textarea>
                </div>

                <div class="col-md-12">
                    <label asp-for="TrabajosRealizados" class="form-label">
                        Trabajos realizados
                    </label>
                    <textarea asp-for="TrabajosRealizados"
                              class="form-control"
                              rows="3"
                              placeholder="Detalle de los trabajos realizados…"></textarea>
                </div>
            </div>
        </div>

        <!-- ================= FOTOS ================= -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-camera me-2"></i> Evidencia fotográfica
            </div>

            <div class="card-body">
                <input type="file" name="photos" class="form-control" multiple />
            </div>
        </div>

        <!-- ================= BOCETO ================= -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-pencil-square me-2"></i> Boceto del vehículo
            </div>

            <div class="card-body">
                <div id="sketch-container"
                     class="sketch-container border rounded p-2"
                     style="max-width:600px;">
                    <img src="~/images/car-sketch.png" class="img-fluid" />
                </div>

                <input type="hidden" id="SketchData" name="SketchData" />
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save me-1"></i> Guardar mantenimiento
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        .sketch-container {
            position: relative;
            display: inline-block;
        }

        .sketch-mark {
            position: absolute;
            color: red;
            font-size: 22px;
            transform: translate(-50%, -50%);
            cursor: pointer;
        }
    </style>

    <script>
        (function () {
            const container = document.getElementById('sketch-container');
            const img = container.querySelector('img');
            const hidden = document.getElementById('SketchData');

            let marks = [];

            function render() {
                container.querySelectorAll('.sketch-mark').forEach(x => x.remove());

                marks.forEach((m, i) => {
                    const el = document.createElement('div');
                    el.className = 'sketch-mark';
                    el.textContent = 'X';
                    el.style.left = m.x + 'px';
                    el.style.top = m.y + 'px';

                    el.addEventListener('click', function (e) {
                        e.stopPropagation();          // ✅ CLAVE
                        marks.splice(i, 1);
                        render();
                    });

                    container.appendChild(el);
                });

                hidden.value = marks.map(m => `${m.x},${m.y}`).join('|');
            }

            img.addEventListener('click', function (e) {
                const rect = img.getBoundingClientRect();
                marks.push({
                    x: Math.round(e.clientX - rect.left),
                    y: Math.round(e.clientY - rect.top)
                });
                render();
            });

            // 🔒 GARANTIZA que se envíe antes del submit
            container.closest('form').addEventListener('submit', function () {
                hidden.value = marks.map(m => `${m.x},${m.y}`).join('|');
            });
        })();
    </script>
}