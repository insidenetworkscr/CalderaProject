@model TallerCaldera2.Models.Maintenance

@{
    ViewData["Title"] = "Detalle del mantenimiento";
    var sketchData = string.Join("|",
        Model.SketchMarks?.Select(m => m.PosX + "," + m.PosY)
        ?? Enumerable.Empty<string>());
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-wrench-adjustable me-2"></i> Detalle del mantenimiento
        </h2>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Editar
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-info-circle me-2"></i> Datos del mantenimiento
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Fecha</dt>
                        <dd class="col-sm-8">@Model.Date.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Vehículo</dt>
                        <dd class="col-sm-8">@Model.VehiclePlate</dd>

                        <dt class="col-sm-4">Tipo</dt>
                        <dd class="col-sm-8">@Model.Type</dd>

                        <dt class="col-sm-4">Proveedor</dt>
                        <dd class="col-sm-8">@Model.Provider</dd>

                        <dt class="col-sm-4">Kilometraje</dt>
                        <dd class="col-sm-8">@Model.Mileage</dd>

                        <dt class="col-sm-4">Costo</dt>
                        <dd class="col-sm-8">₡@Model.Cost</dd>

                        <dt class="col-sm-4">Observaciones</dt>
                        <dd class="col-sm-8">@Model.Observations</dd>

                        <!-- 🔹 NUEVOS CAMPOS -->
                        <dt class="col-sm-4">Trabajos por realizar</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.TrabajosPorRealizar)
                                ? "—"
                                : Model.TrabajosPorRealizar)
                        </dd>

                        <dt class="col-sm-4">Trabajos realizados</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.TrabajosRealizados)
                                ? "—"
                                : Model.TrabajosRealizados)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-pencil-square me-2"></i> Boceto del vehículo
                </div>

                <div class="card-body">
                    <div id="sketch-container"
                         class="sketch-container border rounded p-2"
                         data-initial-marks="@sketchData">
                        <img src="~/images/car-sketch.png" class="img-fluid" />
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <style>
        .sketch-container {
            position: relative;
            display: inline-block;
        }

        .sketch-mark {
            position: absolute;
            color: red;
            font-size: 22px;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }
    </style>

    <script>
        (function () {
            const container = document.getElementById('sketch-container');
            const data = container.dataset.initialMarks;
            if (!data) return;

            data.split('|').forEach(p => {
                const [x, y] = p.split(',');
                const el = document.createElement('div');
                el.className = 'sketch-mark';
                el.textContent = 'X';
                el.style.left = x + 'px';
                el.style.top = y + 'px';
                container.appendChild(el);
            });
        })();
    </script>
}