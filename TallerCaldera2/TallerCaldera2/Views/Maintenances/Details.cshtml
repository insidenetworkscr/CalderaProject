@model TallerCaldera2.Models.Maintenance

@{
    ViewData["Title"] = "Detalle del mantenimiento";
    var sketchData = string.Join("|",
        Model.SketchMarks?.Select(m => m.PosX + "," + m.PosY)
        ?? Enumerable.Empty<string>());
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-wrench-adjustable me-2"></i> Detalle del mantenimiento
        </h2>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Editar
            </a>
        </div>
    </div>

    <div class="row g-4">

        <!-- ================= DATOS ================= -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-info-circle me-2"></i> Datos del mantenimiento
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Fecha</dt>
                        <dd class="col-sm-8">@Model.Date.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Vehículo</dt>
                        <dd class="col-sm-8">@Model.VehiclePlate</dd>

                        <dt class="col-sm-4">Tipo</dt>
                        <dd class="col-sm-8">@Model.Type</dd>

                        <dt class="col-sm-4">Proveedor</dt>
                        <dd class="col-sm-8">@Model.Provider</dd>

                        <dt class="col-sm-4">Kilometraje</dt>
                        <dd class="col-sm-8">@Model.Mileage</dd>

                        <dt class="col-sm-4">Costo</dt>
                        <dd class="col-sm-8">₡@Model.Cost</dd>

                        <dt class="col-sm-4">Observaciones</dt>
                        <dd class="col-sm-8">@Model.Observations</dd>

                        <dt class="col-sm-4">Trabajos por realizar</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.TrabajosPorRealizar)
                                ? "—"
                                : Model.TrabajosPorRealizar)
                        </dd>

                        <dt class="col-sm-4">Trabajos realizados</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.TrabajosRealizados)
                                ? "—"
                                : Model.TrabajosRealizados)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- ================= BOCETO ================= -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-pencil-square me-2"></i> Boceto del vehículo
                </div>

                <div class="card-body">
                    <div id="sketch-container"
                         class="sketch-container border rounded p-2"
                         data-initial-marks="@sketchData">

                        <img id="sketch-img"
                             src="~/images/car-sketch.png"
                             class="img-fluid" />
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= SERVICIOS ================= -->
    <div class="card shadow-sm border-0 rounded-4 mt-4">
        <div class="card-header bg-light fw-semibold">
            <i class="bi bi-list-check me-2"></i> Servicios realizados
        </div>

        <div class="card-body">
            @if (Model.Items == null || !Model.Items.Any())
            {
                <p class="text-muted mb-0">No hay servicios registrados.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Servicio</th>
                                <th>Unidad</th>
                                <th class="text-end">Precio</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td style="white-space:pre-line">@item.Servicio</td>
                                    <td>@item.Unidad</td>
                                    <td class="text-end">₡@item.Precio.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

@section Scripts {
    <style>
        .sketch-container {
            position: relative;
            display: inline-block;
        }

        .sketch-mark {
            position: absolute;
            color: red;
            font-size: 22px;
            transform: translate(-50%, -50%);
            pointer-events: none;
            font-weight: bold;
        }
    </style>

    <script>
        (function () {
            const container = document.getElementById('sketch-container');
            const img = document.getElementById('sketch-img');
            const data = container.dataset.initialMarks;
            if (!data) return;

            img.onload = function () {

                const imgRect = img.getBoundingClientRect();
                const containerRect = container.getBoundingClientRect();

                const offsetX = imgRect.left - containerRect.left;
                const offsetY = imgRect.top - containerRect.top;

                const scaleX = img.clientWidth / img.naturalWidth;
                const scaleY = img.clientHeight / img.naturalHeight;

                data.split('|').forEach(p => {
                    const [x, y] = p.split(',').map(Number);

                    const el = document.createElement('div');
                    el.className = 'sketch-mark';
                    el.textContent = 'X';

                    el.style.left = (x * scaleX + offsetX) + 'px';
                    el.style.top = (y * scaleY + offsetY) + 'px';

                    container.appendChild(el);
                });
            };
        })();
    </script>
}
