@model IEnumerable<TallerCaldera2.Models.Maintenance>

@{
    ViewData["Title"] = "Mantenimientos";
}

<style>
    .maintenance-row {
        border-bottom: 1px solid #e9ecef;
    }

        .maintenance-row:hover {
            background-color: #f8f9fa;
        }

    .maintenance-main {
        min-width: 260px;
    }

    .vehicle-box {
        font-weight: 600;
        background: #212529;
        color: #fff;
        padding: 6px 10px;
        border-radius: 6px;
        display: inline-block;
    }

    .cost-box {
        font-weight: 700;
        color: #198754;
        font-size: 1rem;
        white-space: nowrap;
    }

    .icon-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .85rem;
        padding: 4px 8px;
        border-radius: 6px;
        background: #f1f3f5;
    }

    .photo-thumb {
        width: 36px;
        height: 28px;
        object-fit: cover;
        border-radius: 4px;
        margin-right: 3px;
        border: 1px solid #ddd;
    }

    .no-results {
        display: none;
    }
</style>


<section class="container-fluid px-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-0">🔧 Mantenimientos</h2>
            <small class="text-muted">
                Buscar por tipo, proveedor o placa + filtrar por fechas
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Crear nuevo
        </a>
    </div>

    <!-- Filtros -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Buscar</label>
                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           placeholder="Tipo, proveedor o placa"
                           onkeyup="filterMaintenances()" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Desde</label>
                    <input type="date"
                           id="dateFrom"
                           class="form-control"
                           onchange="filterMaintenances()" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Hasta</label>
                    <input type="date"
                           id="dateTo"
                           class="form-control"
                           onchange="filterMaintenances()" />
                </div>

                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100"
                            onclick="clearFilters()">
                        Limpiar
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Mantenimiento</th>
                        <th>Vehículo</th>
                        <th>Estado</th>
                        <th class="text-end">Costo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody id="maintenanceTable">
                    @foreach (var item in Model)
                    {
                        <tr class="maintenance-row maintenance-item"
                            data-search="@($"{item.Type} {item.Provider} {item.VehiclePlate}".ToLower())"
                            data-date="@item.Date.ToString("yyyy-MM-dd")">

                            <!-- INFO PRINCIPAL -->
                            <td class="maintenance-main">
                                <div class="fw-semibold">@item.Type</div>

                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i>
                                    @item.Date.ToString("dd/MM/yyyy")
                                </small><br />

                                <small class="text-muted">
                                    <i class="bi bi-shop"></i>
                                    @item.Provider
                                </small>
                            </td>

                            <!-- VEHÍCULO -->
                            <td>
                                <span class="vehicle-box">
                                    @item.VehiclePlate
                                </span>
                            </td>

                            <!-- ESTADO -->
                            <td>
                                <div class="d-flex gap-2 flex-wrap">

                                    <!-- Fotos -->
                                    @if (item.Photos != null && item.Photos.Any())
                                    {
                                        <span class="icon-badge">
                                            <i class="bi bi-image"></i>
                                            @item.Photos.Count
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="icon-badge text-muted">
                                            <i class="bi bi-image"></i> 0
                                        </span>
                                    }

                                    <!-- Boceto -->
                                    @if (item.SketchMarks != null && item.SketchMarks.Any())
                                    {
                                        <span class="icon-badge">
                                            <i class="bi bi-pencil"></i>
                                            @item.SketchMarks.Count
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="icon-badge text-muted">
                                            <i class="bi bi-pencil"></i> 0
                                        </span>
                                    }

                                </div>
                            </td>

                            <!-- COSTO -->
                            <td class="text-end">
                                <span class="cost-box">
                                    ₡@(item.Cost?.ToString("N0") ?? "0")
                                </span>
                            </td>

                            <!-- ACCIONES -->
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Sin resultados -->
    <div id="noResults" class="text-center text-muted mt-5 no-results">
        <i class="bi bi-tools fs-1"></i>
        <p class="mt-2">No se encontraron mantenimientos</p>
    </div>

</section>

<script>
    function filterMaintenances() {
        const search = document.getElementById("searchInput").value.toLowerCase();
        const from = document.getElementById("dateFrom").value;
        const to = document.getElementById("dateTo").value;

        const rows = document.querySelectorAll(".maintenance-item");
        let visible = 0;

        rows.forEach(row => {
            const text = row.dataset.search;
            const date = row.dataset.date;

            let matchesSearch = text.includes(search);
            let matchesDate = true;

            if (from && date < from) matchesDate = false;
            if (to && date > to) matchesDate = false;

            if (matchesSearch && matchesDate) {
                row.style.display = "";
                visible++;
            } else {
                row.style.display = "none";
            }
        });

        document.getElementById("noResults").style.display =
            visible === 0 ? "block" : "none";
    }

    function clearFilters() {
        document.getElementById("searchInput").value = "";
        document.getElementById("dateFrom").value = "";
        document.getElementById("dateTo").value = "";
        filterMaintenances();
    }
</script>
