@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Login - Taller Caldera</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #991b1b, #dc2626);
        }
    </style>
</head>

<body class="d-flex justify-content-center align-items-center vh-100">

    <div class="card shadow-lg" style="width:420px;">
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <i class="bi bi-gear-fill text-danger" style="font-size:3rem;"></i>
                <h4 class="fw-bold mt-2">Caldera Performance</h4>
                <p class="text-muted">Acceso de personal</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center fw-semibold">
                    @ViewBag.Error
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center fw-semibold">
                    @TempData["Success"]
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input name="fullName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input name="password" type="password" class="form-control" required />
                </div>

                <button class="btn btn-danger w-100 fw-semibold">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar
                </button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Register" class="text-decoration-none text-dark">
                    Registrar trabajador
                </a>
            </div>
        </div>
    </div>

</body>
</html>
