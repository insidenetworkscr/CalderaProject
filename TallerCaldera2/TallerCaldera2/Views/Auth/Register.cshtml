@model TallerCaldera2.Models.User
@{
    Layout = null;
    ViewData["Title"] = "Registro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Registro - Taller Caldera</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="d-flex justify-content-center align-items-center vh-100 bg-light">

    <div class="card shadow-lg border-0" style="width:480px;">
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <i class="bi bi-person-plus-fill text-success" style="font-size:3rem;"></i>
                <h4 class="fw-bold mt-2">Registro de Trabajador</h4>
                <p class="text-muted">Solo personal autorizado</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.Error</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Nombre completo</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Correo</label>
                    <input asp-for="Email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input asp-for="PasswordHash" type="password" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Código de registro</label>
                    <input name="registerCode" class="form-control" required />
                </div>

                <button class="btn btn-success w-100 fw-semibold">
                    Registrar
                </button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Login" class="text-decoration-none">
                    Volver al login
                </a>
            </div>
        </div>
    </div>

</body>
</html>
